# Copy to .env and fill in. Never commit .env.

# GigaChat: Authorization key from developers.sber.ru (base64 of client_id:client_secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# GigaChat uses the Russian Trusted Root CA. Prefer pointing to the certificate
# over disabling verification: https://www.gosuslugi.ru/crt
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_VERIFY_SSL=true

LLM_TEMPERATURE=0.1
# Used only for cost analytics (p50 / p95 per request)
LLM_PRICE_RUB_PER_1K_TOKENS=1.5

ASR_BACKEND=gigaam
GIGAAM_MODEL=v3_e2e_rnnt

# Dialog context. Empty value = in-memory history (lost on restart)
REDIS_URL=redis://localhost:6379/0

# Empty = MCP server runs in-process; set to use a separately started server
MCP_URL=
STORAGE_PATH=data/events.sqlite3
TIMEZONE=Europe/Moscow
