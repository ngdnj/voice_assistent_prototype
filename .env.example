# Local Compose instance. Application reads environment, not .env automatically.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2
REDIS_COMMAND_TIMEOUT=2
# Integration tests: set RUN_REDIS_INTEGRATION=1 only for a test Redis instance.

# Role 4: local Compose PostgreSQL. Port 5433 avoids a locally installed server on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=it_gorky
POSTGRES_USER=it_gorky
POSTGRES_PASSWORD=local-dev-only
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_COMMAND_TIMEOUT=5
POSTGRES_POOL_SIZE=5
# Integration tests: RUN_PG_INTEGRATION=1 uses only POSTGRES_TEST_DB (name must contain "test").
POSTGRES_TEST_DB=it_gorky_test

# Role 4: MCP server (python -m app.mcp_server). The token is shared with the agent worker; >= 32 chars.
MCP_SERVICE_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp
# Mini App REST (/api/*): enabled only with the MAX bot token that signs initData. Never put it in frontend code.
MAX_BOT_TOKEN=
# Comma-separated Mini App origins for CORS, e.g. https://app.example.ru; empty disables CORS.
MINI_APP_ORIGINS=

# Role 2: MAX bot (python -m app.bot for local long polling; webhook router app/bot/webhook.py).
# MAX_BOT_TOKEN above is shared: the bot sends messages with it, REST checks initData with it.
MAX_API_URL=https://platform-api2.max.ru
# Extra CA bundle (PEM) if MAX uses the Russian Trusted Root CA:
# https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
MAX_CA_BUNDLE_FILE=
# Webhook secret, 5-256 chars [A-Za-z0-9_-]; required for the webhook, not for long polling.
MAX_WEBHOOK_SECRET=
# Explicit product time zone until user profiles store one.
MAX_DEFAULT_TIMEZONE=Europe/Moscow
# Comma-separated host suffixes audio may be downloaded from (HTTPS only).
MAX_AUDIO_HOSTS=max.ru
MAX_AUDIO_MAX_BYTES=10485760
MAX_SEND_TIMEOUT_S=10
BOT_PROCESSING_TIMEOUT_S=120
BOT_BUSY_TTL_S=180
BOT_MAX_CONCURRENCY=8
# Only for `python -m app.bot`: delay of the demo reply, to check the "busy" answer by hand.
BOT_DEMO_DELAY_S=0

# Local backend CLI, no MAX/AI credentials needed.
# Required only for `python -m app example`; trusted local demonstration identity.
BACKEND_DEMO_OWNER_ID=local-demo
BACKEND_SHUTDOWN_TIMEOUT=5

# --- Role 3: LLM + ASR (app/config.py reads these, and .env if present) ---

# GigaChat API: Authorization Key from developers.sber.ru. Scope must match the key:
# GIGACHAT_API_PERS (individual), GIGACHAT_API_B2B or GIGACHAT_API_CORP (business).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# GigaChat uses the Russian Trusted Root CA: https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_VERIFY_SSL=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=12
LLM_MAX_RETRIES=1
# Rubles per 1000 tokens for cost analytics; 0 on a prepaid package
LLM_PRICE_INPUT_RUB_PER_1K=0
LLM_PRICE_OUTPUT_RUB_PER_1K=0

# gigaam (local, CPU, needs ffmpeg and `uv sync --extra asr`) | yandex (SpeechKit API v1)
ASR_BACKEND=gigaam
GIGAAM_MODEL=v3_e2e_rnnt
# Service account API key with the ai.speechkit-stt.user role
YANDEX_API_KEY=
# Only for a user account; leave empty for a service account key
YANDEX_FOLDER_ID=

# Dialog history of the agent prototype (role 1 owns the final Redis keys and settings)
REDIS_URL=redis://localhost:6379/0
HISTORY_MAX_TURNS=20
HISTORY_MAX_TOKENS=3000
HISTORY_TTL_S=604800

# Only for comparing models in evals (`uv sync --extra compare`); costs money
CLOUDRU_API_KEY=
CLOUDRU_MODEL=ai-sage/GigaChat3.5-432B-A28B-Reasoning
