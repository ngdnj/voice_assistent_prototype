# Copy to .env and fill in. Never commit .env.

# LLM provider: cloudru (Cloud.ru Foundation Models) or gigachat (developers.sber.ru)
LLM_PROVIDER=cloudru
LLM_TEMPERATURE=0.1
# Rubles per 1000 tokens, for cost analytics (p50 / p95 per request).
# GigaChat 3.5 on Cloud.ru, price list v260915 incl. VAT: 96.22 RUB / 1M input, 288.60 RUB / 1M output
LLM_PRICE_INPUT_RUB_PER_1K=0.0962
LLM_PRICE_OUTPUT_RUB_PER_1K=0.2886

# Cloud.ru: console.cloud.ru -> service account -> API key
CLOUDRU_API_KEY=
CLOUDRU_MODEL=ai-sage/GigaChat3.5-432B-A28B-Reasoning

# GigaChat API directly: Authorization key from developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# GigaChat uses the Russian Trusted Root CA: https://www.gosuslugi.ru/crt
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_VERIFY_SSL=true

# gigaam (local, CPU) | yandex (SpeechKit API v1, needs YANDEX_API_KEY)
ASR_BACKEND=gigaam
GIGAAM_MODEL=v3_e2e_rnnt
# Service account API key with the ai.speechkit-stt.user role
YANDEX_API_KEY=
# Only for a user account; leave empty for a service account key
YANDEX_FOLDER_ID=

# Dialog context. Empty value = in-memory history (lost on restart)
REDIS_URL=redis://localhost:6379/0
HISTORY_MAX_TURNS=20
HISTORY_MAX_TOKENS=3000
HISTORY_TTL_S=604800

# Empty = MCP server runs in-process; set to use a separately started server
MCP_URL=
STORAGE_PATH=data/events.sqlite3
TIMEZONE=Europe/Moscow
