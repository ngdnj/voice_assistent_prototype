diff --git a/tests/test_meeting_overlap_pg.py b/tests/test_meeting_overlap_pg.py
new file mode 100644
index 0000000..c8b6a09
--- /dev/null
+++ b/tests/test_meeting_overlap_pg.py
@@ -0,0 +1,53 @@
+"""ROLE 4 (local, proposed by role 3): a meeting with an end is in every period it overlaps."""
+
+from datetime import UTC, date, datetime, timedelta
+from typing import Any
+
+import pytest
+
+from app.agent.mcp import Caller
+from evals.backend import evaluation_backend
+from tests.storage_pg import RUN_PG_INTEGRATION
+
+pytestmark = pytest.mark.skipif(
+    not RUN_PG_INTEGRATION, reason="set RUN_PG_INTEGRATION=1 and POSTGRES_TEST_DB"
+)
+
+NOW = datetime(2026, 10, 19, 9, tzinfo=UTC)
+ZONE = "Europe/Moscow"
+
+
+def _day(day: str) -> dict[str, str]:
+    """[00:00, 00:00 of the next day) in Moscow."""
+    next_day = (date.fromisoformat(day) + timedelta(days=1)).isoformat()
+    return {"start_time": f"{day}T00:00:00+03:00", "end_time": f"{next_day}T00:00:00+03:00"}
+
+
+async def test_period_selects_meetings_by_overlap() -> None:
+    async with evaluation_backend(NOW, ZONE) as mcp:
+        caller = Caller(mcp.owner, ZONE, "req")
+
+        async def call(name: str, arguments: dict[str, Any], action: str = "") -> dict[str, Any]:
+            return await mcp.call(caller, name, arguments, action_id=action or name)
+
+        for number, (name, start, end) in enumerate(
+            [
+                ("Отпуск", "2026-11-01T09:00:00+03:00", "2026-11-10T18:00:00+03:00"),
+                ("Ночной созвон", "2026-11-04T23:00:00+03:00", "2026-11-05T01:00:00+03:00"),
+                ("Планёрка", "2026-11-05T10:00:00+03:00", None),
+                ("Утренняя встреча", "2026-11-04T08:00:00+03:00", "2026-11-05T00:00:00+03:00"),
+            ]
+        ):
+            args = {"event_type": "meeting", "name": name, "datetime": start}
+            if end:
+                args["end_time"] = end
+            assert "created" in await call("create_event", args, f"seed-{number}")
+
+        names = [e["name"] for e in (await call("get_events_by_period", _day("2026-11-05")))["events"]]
+        # Started earlier but still going; the meeting ending exactly at 00:00 is not in the next day.
+        assert names == ["Отпуск", "Ночной созвон", "Планёрка"]
+        before = await call("get_events_by_period", _day("2026-10-31"))
+        assert before["events"] == []
+        # A search with a period uses the same rule.
+        found = await call("get_event_by_query", {"query": "отпуск", **_day("2026-11-07")})
+        assert [e["name"] for e in found["events"]] == ["Отпуск"]
diff --git a/tests/test_search_prefix_pg.py b/tests/test_search_prefix_pg.py
new file mode 100644
index 0000000..f571fa9
--- /dev/null
+++ b/tests/test_search_prefix_pg.py
@@ -0,0 +1,38 @@
+"""ROLE 4 (local, proposed by role 3): a name in the nominative finds it in other cases."""
+
+from datetime import UTC, datetime
+from typing import Any
+
+import pytest
+
+from app.agent.mcp import Caller
+from evals.backend import evaluation_backend
+from tests.storage_pg import RUN_PG_INTEGRATION
+
+pytestmark = pytest.mark.skipif(
+    not RUN_PG_INTEGRATION, reason="set RUN_PG_INTEGRATION=1 and POSTGRES_TEST_DB"
+)
+
+NOW = datetime(2026, 10, 19, 9, tzinfo=UTC)
+
+
+async def test_search_finds_names_across_cases_and_keeps_syntax() -> None:
+    async with evaluation_backend(NOW, "Europe/Moscow") as mcp:
+        caller = Caller(mcp.owner, "Europe/Moscow", "req")
+
+        async def names(query: str) -> list[str]:
+            result: dict[str, Any] = await mcp.call(
+                caller, "get_event_by_query", {"query": query}, action_id="read"
+            )
+            return sorted(e["name"] for e in result["events"])
+
+        for number, name in enumerate(["Встреча с Иваном", "Созвон с Михаилом", "Звонок бухгалтеру"]):
+            args = {"event_type": "task", "name": name}
+            assert "created" in await mcp.call(caller, "create_event", args, action_id=f"seed-{number}")
+
+        # «Иван» stems to «ива», «Иваном» to «иван»: without prefixes the name was not found.
+        assert await names("Иван") == ["Встреча с Иваном"]
+        assert await names("Михаил") == ["Созвон с Михаилом"]
+        assert await names("созвон or бухгалтер") == ["Звонок бухгалтеру", "Созвон с Михаилом"]
+        assert await names("встреча -Иван") == []
+        assert await names("ремонт") == []
