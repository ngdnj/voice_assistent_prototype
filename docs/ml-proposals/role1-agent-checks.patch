diff --git a/tests/test_agent_arg_checks.py b/tests/test_agent_arg_checks.py
new file mode 100644
index 0000000..3803caa
--- /dev/null
+++ b/tests/test_agent_arg_checks.py
@@ -0,0 +1,76 @@
+"""Role 3's argument checks inside role 1's agent loop (ROLE 1, local: app/agent/agent.py)."""
+
+from datetime import UTC, datetime
+
+from langchain_core.messages import AIMessage, ToolMessage
+from langchain_core.messages.ai import UsageMetadata
+
+from app.agent.agent import Assistant
+from app.agent.history import InMemoryChatHistory
+from app.llm.arg_checks import UNDATED_TASKS_ANSWER
+from tests.agent_support import ScriptedModel, tool
+from tests.test_agent import Gateway
+
+# 22:23 in Moscow.
+EVENING = datetime(2026, 10, 19, 19, 23, 55, tzinfo=UTC)
+TIME = {"reference_time": EVENING, "timezone": "Europe/Moscow"}
+
+
+async def test_past_time_today_is_not_saved_and_model_is_told_why() -> None:
+    past = {"event_type": "meeting", "name": "Совещание", "datetime": "2026-10-19T10:00:00+03:00"}
+    model = ScriptedModel(
+        responses=[tool(arguments=past), AIMessage("10:00 уже прошло, поставить на завтра?")]
+    )
+    gateway = Gateway()
+    reply = await Assistant(model, gateway, InMemoryChatHistory()).handle(
+        "owner", "Сегодня в 10 утра совещание", operation_id="turn-1", **TIME
+    )
+    assert gateway.calls == []  # nothing reached the server
+    [call] = reply.tool_calls
+    assert call.result is not None and "уже прошло" in call.result["error"]["message"]
+    told = [m for m in model.seen[-1] if isinstance(m, ToolMessage)]
+    assert "поставить на завтра" in told[-1].text
+
+
+async def test_reminder_end_from_next_record_is_dropped_before_the_call() -> None:
+    leaked = {
+        "event_type": "reminder",
+        "name": "Позвонить маме",
+        "datetime": "2026-10-20T09:00:00+03:00",
+        "end_time": "2026-10-20T18:00:00+03:00",
+    }
+    model = ScriptedModel(responses=[tool(arguments=leaked), AIMessage("Напомню завтра в 9:00.")])
+    gateway = Gateway()
+    reply = await Assistant(model, gateway, InMemoryChatHistory()).handle(
+        "owner", "Напомни завтра в 9 позвонить маме и в 18 забрать посылку", operation_id="turn-1", **TIME
+    )
+    [(_, _, sent, _)] = gateway.calls
+    assert "end_time" not in sent
+    assert "end_time" not in reply.tool_calls[0].args  # the trace shows what was sent
+
+
+async def test_cached_prompt_tokens_are_counted_separately() -> None:
+    usage = UsageMetadata(
+        input_tokens=200, output_tokens=30, total_tokens=230, input_token_details={"cache_read": 2500}
+    )
+    model = ScriptedModel(responses=[AIMessage("Здравствуйте!", usage_metadata=usage)])
+    reply = await Assistant(model, Gateway(), InMemoryChatHistory()).handle(
+        "owner", "Привет", operation_id="turn-1", **TIME
+    )
+    assert (reply.input_tokens, reply.cached_input_tokens, reply.output_tokens) == (200, 2500, 30)
+
+
+class TasksGateway(Gateway):
+    async def call(self, caller, name, arguments, *, action_id):
+        self.calls.append((caller, name, arguments, action_id))
+        return {"events": [], "truncated": False}
+
+
+async def test_list_of_tasks_built_by_code_says_undated_tasks_are_not_shown() -> None:
+    week = {"start_time": "2026-10-19T00:00:00+03:00", "end_time": "2026-10-26T00:00:00+03:00"}
+    period = tool("get_events_by_period", {**week, "event_types": ["task"]})
+    model = ScriptedModel(responses=[period, AIMessage("Задач на неделю нет.")])
+    reply = await Assistant(model, TasksGateway(), InMemoryChatHistory()).handle(
+        "owner", "Покажи мои задачи", operation_id="turn-1", **TIME
+    )
+    assert UNDATED_TASKS_ANSWER in reply.text
